<EntityForm xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:dummy="0" flexi="1" fleximode="2" fullscreen="0" resize="0" version="2" layoutstrict="1" singlecardexpand="0" pagesposition="1" pageiconposition="0">
  <IsContactForm>false</IsContactForm>
  <EntityName>account</EntityName>
  <CamelCase>account</CamelCase>
  <SharedVariables>&lt;SharedVariables&gt;&lt;Variables&gt;&lt;/Variables&gt;&lt;/SharedVariables&gt;</SharedVariables>
  <IsBulkUpdateForm>false</IsBulkUpdateForm>
  <CacheMode>-1</CacheMode>
  <UiSyncGuardMode>-1</UiSyncGuardMode>
  <PrimaryCommands></PrimaryCommands>
  <SharedVariableNames/>
  <ClassBinding/>
  <EnabledWorkflows>OnLoadEnabled OnChangeEnabled OnSaveEnabled</EnabledWorkflows>
  <SerializedChildrenV2>
    <FormTab xsi:type="DetailTab" flexiHeader="2" NameModified="1" IconModified="0" EntityIconName="MobileCrm\Images.MonoTouch\Tabs\General@2x.png" IsIconNameReadOnly="0">
      <Name>DETAILS</Name>
      <SerializedChildren>
        <DetailItem SchemaName="name" Style="Normal"/>
        <DetailItem SchemaName="emailaddress1" Style="Normal"/>
        <DetailItem SchemaName="websiteurl"/>
        <DetailItem SchemaName="telephone1" Style="Normal"/>
        <DetailItem SchemaName="primarycontactid"/>
        <DetailItem SchemaName="ownerid"/>
      </SerializedChildren>
    </FormTab>
    <FormTab xsi:type="DetailTab" flexi="1" flexiHeader="2" NameModified="1" IconModified="0" EntityIconName="MobileCrm\Images.MonoTouch\Tabs\General@2x.png" IsIconNameReadOnly="0">
      <Name>ADDRESS</Name>
      <SerializedChildren>
        <DetailItem SchemaName="$Table1" grid="true">
          <Columns>*;*</Columns>
          <Rows>Auto;Auto;Auto;Auto;Auto</Rows>
          <Items>
            <DetailItem SchemaName="address1_line1" Style="Normal">
              <GridPosition>0;0;2;1</GridPosition>
            </DetailItem>
            <DetailItem SchemaName="address1_line2" Style="Normal">
              <GridPosition>0;1;2;1</GridPosition>
            </DetailItem>
            <DetailItem SchemaName="address1_line3" Style="Normal">
              <GridPosition>0;2;2;1</GridPosition>
            </DetailItem>
            <DetailItem SchemaName="address1_city" Style="Normal">
              <GridPosition>0;3;1;1</GridPosition>
            </DetailItem>
            <DetailItem SchemaName="address1_postalcode" Style="Normal">
              <GridPosition>1;3;1;1</GridPosition>
            </DetailItem>
            <DetailItem SchemaName="address1_stateorprovince" Style="Normal">
              <GridPosition>0;4;1;1</GridPosition>
            </DetailItem>
            <DetailItem SchemaName="address1_country" Style="Normal">
              <GridPosition>1;4;1;1</GridPosition>
            </DetailItem>
          </Items>
        </DetailItem>
      </SerializedChildren>
    </FormTab>
    <FormTab xsi:type="MapTab" flexiHeight="450px" flexiHeader="0" NameModified="0" IconModified="0" EntityIconName="MobileCrm\Images.MonoTouch\Tabs\Map@2x.png" IsIconNameReadOnly="0">
      <Name>Map</Name>
      <CoordinatesBinding>address1_latitude;address1_longitude</CoordinatesBinding>
    </FormTab>
    <FormTab xsi:type="AssociatedTab" flexiWidth="1" flexiHeader="2" NameModified="1" IconModified="0" EntityIconName="MobileCrm\Images.MonoTouch\Tabs\contact@2x.png" IsIconNameReadOnly="0" DocCommands="0">
      <Name>CONTACTS</Name>
      <CustomName>CONTACTS</CustomName>
      <Binding SchemaName="contact.parentcustomerid"/>
      <Views>contact.@Subgrid</Views>
    </FormTab>
    <FormTab xsi:type="AssociatedTab" flexi="0" flexiHeight="6" flexiHeader="2" NameModified="1" IconModified="0" EntityIconName="MobileCrm\Images.MonoTouch\Tabs\activity@2x.png" IsIconNameReadOnly="0" DocCommands="0">
      <Name>ACTIVITIES</Name>
      <CustomName>ACTIVITIES</CustomName>
      <Binding SchemaName="activity.regardingobjectid"/>
      <Views>@activity.*:activity.@My Activities:appointment.*:task.*</Views>
    </FormTab>
    <FormTab xsi:type="AssociatedTab" flexi="0" flexiHeight="6" flexiHeader="2" NameModified="1" IconModified="0" EntityIconName="MobileCrm\Images.MonoTouch\Tabs\annotation@2x.png" IsIconNameReadOnly="0" FlipMode="224">
      <Name>NOTES</Name>
      <CustomName>NOTES</CustomName>
      <Binding SchemaName="annotation.objectid"/>
      <Views>annotation.@Default</Views>
    </FormTab>
  </SerializedChildrenV2>
  <FormPages>
    <FormPages layoutstrict="1" singlecardexpand="0" fleximode="2" iconposition="0">
      <Name>DETAILS</Name>
      <IconName></IconName>
      <TabIndexes>
        <int>0</int>
        <int>1</int>
        <int>2</int>
        <int>3</int>
      </TabIndexes>
    </FormPages>
    <FormPages layoutstrict="1" singlecardexpand="0" fleximode="0" iconposition="0">
      <Name>ACTIVITIES + NOTES</Name>
      <IconName></IconName>
      <TabIndexes>
        <int>4</int>
        <int>5</int>
      </TabIndexes>
    </FormPages>
  </FormPages>
</EntityForm>
<EntityForm xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:dummy="0" flexi="1" fleximode="2" fullscreen="0" resize="0" version="2" layoutstrict="1" singlecardexpand="0" pagesposition="1" pageiconposition="0">
  <IsContactForm>false</IsContactForm>
  <EntityName>task</EntityName>
  <CamelCase>task</CamelCase>
  <WorkflowLoad>&lt;?xml version="1.0" ?&gt;&lt;Workflow e="true" isvalid="true" syntaxVersion="11" version="0"&gt;&lt;function e="false"&gt;&lt;var&gt;Form.statuscode.IsEnabled&lt;/var&gt;&lt;func&gt;Assign&lt;/func&gt;&lt;arg&gt;Boolean:False&lt;/arg&gt;&lt;/function&gt;&lt;function e="false"&gt;&lt;var&gt;Tabs.INSPECTIONS.IsVisible&lt;/var&gt;&lt;func&gt;Assign&lt;/func&gt;&lt;arg&gt;Boolean:False&lt;/arg&gt;&lt;/function&gt;&lt;function e="false"&gt;&lt;var&gt;Tabs.INSPECTION REPORTS.IsVisible&lt;/var&gt;&lt;func&gt;Assign&lt;/func&gt;&lt;arg&gt;Boolean:False&lt;/arg&gt;&lt;/function&gt;&lt;/Workflow&gt;</WorkflowLoad>
  <SharedVariables>&lt;SharedVariables&gt;&lt;Variables&gt;&lt;/Variables&gt;&lt;/SharedVariables&gt;</SharedVariables>
  <IsBulkUpdateForm>false</IsBulkUpdateForm>
  <CacheMode>-1</CacheMode>
  <UiSyncGuardMode>-1</UiSyncGuardMode>
  <PrimaryCommands>!defcmd</PrimaryCommands>
  <SharedVariableNames/>
  <ClassBinding/>
  <EnabledWorkflows>OnLoadEnabled OnChangeEnabled OnSaveEnabled</EnabledWorkflows>
  <SerializedChildrenV2>
    <FormTab xsi:type="DetailTab" flexiHeader="2" NameModified="1" IconModified="0" EntityIconName="MobileCrm\Images.MonoTouch\Tabs\General@2x.png" IsIconNameReadOnly="0">
      <Name>DETAILS</Name>
      <SerializedChildren>
        <DetailItem SchemaName="subject"/>
        <DetailItem SchemaName="regardingobjectid" Style="Normal"/>
        <DetailItem SchemaName="description"/>
        <DetailItem SchemaName="scheduledstart"/>
        <DetailItem SchemaName="scheduledend" Style="Normal"/>
        <DetailItem SchemaName="scheduleddurationminutes"/>
        <DetailItem SchemaName="prioritycode" Style="Horizontal Segmented Button"/>
        <DetailItem SchemaName="$Table1" grid="true">
          <Columns>*;*</Columns>
          <Rows>Auto</Rows>
          <Items>
            <DetailItem SchemaName="statecode">
              <GridPosition>0;0;1;1</GridPosition>
            </DetailItem>
            <DetailItem SchemaName="statuscode">
              <GridPosition>1;0;1;1</GridPosition>
            </DetailItem>
          </Items>
        </DetailItem>
      </SerializedChildren>
    </FormTab>
    <FormTab xsi:type="AssociatedTab" flexiHeight="6" flexiHeader="2" NameModified="1" IconModified="0" EntityIconName="MobileCrm\Images.MonoTouch\Tabs\General@2x.png" IsIconNameReadOnly="0" DocCommands="0" FlipMode="224">
      <Name>ANSWERED QUESTIONNAIRES</Name>
      <CustomName>ANSWERED QUESTIONNAIRES</CustomName>
      <Binding SchemaName="resco_questionnaireanswer.@virtual"/>
      <Views>&lt;extra&gt;&lt;views&gt;resco_questionnaireanswer.@Subgrid&lt;/views&gt;&lt;filter entity="resco_questionnaireanswer"&gt;&amp;lt;fetch version="1.0"&amp;gt;&amp;lt;entity name="resco_questionnaireanswer"&amp;gt;&amp;lt;filter type="and"&amp;gt;&amp;lt;condition attribute="resco_regardingid" operator="eq" value="{{activityid}}" /&amp;gt;&amp;lt;/filter&amp;gt;&amp;lt;/entity&amp;gt;&amp;lt;/fetch&amp;gt;&lt;/filter&gt;&lt;/extra&gt;</Views>
      <LookupViews>resco_questionnaire.Templates</LookupViews>
    </FormTab>
    <FormTab xsi:type="AssociatedTab" flexiHeight="6" flexiHeader="2" NameModified="1" IconModified="0" EntityIconName="MobileCrm\Images.MonoTouch\Tabs\annotation@2x.png" IsIconNameReadOnly="0" DocCommands="0" FlipMode="224" ListCommands="0">
      <Name>GENERATED DOCUMENTS</Name>
      <CustomName>GENERATED DOCUMENTS</CustomName>
      <Binding SchemaName="annotation.@virtual"/>
      <Views>&lt;extra&gt;&lt;views&gt;annotation.@Documents&lt;/views&gt;&lt;filter entity="annotation"&gt;&amp;lt;fetch version="1.0"&amp;gt;&amp;lt;entity name="annotation"&amp;gt;&amp;lt;link-entity name="resco_questionnaireanswer" from="resco_questionnaireanswerid" to="objectid" link-type="inner" alias="L0"&amp;gt;&amp;lt;filter type="and"&amp;gt;&amp;lt;condition attribute="resco_regardingid" operator="eq" value="{{activityid}}" /&amp;gt;&amp;lt;/filter&amp;gt;&amp;lt;/link-entity&amp;gt;&amp;lt;/entity&amp;gt;&amp;lt;/fetch&amp;gt;&lt;/filter&gt;&lt;/extra&gt;</Views>
    </FormTab>
    <FormTab xsi:type="AssociatedTab" flexiHeight="6" flexiHeader="2" NameModified="1" IconModified="0" EntityIconName="MobileCrm\Images.MonoTouch\Tabs\General@2x.png" IsIconNameReadOnly="0" DocCommands="0" FlipMode="224">
      <Name>INSPECTIONS</Name>
      <CustomName>INSPECTIONS</CustomName>
      <Binding SchemaName="resco_questionnaire.@virtual"/>
      <Views>&lt;extra&gt;&lt;views&gt;resco_questionnaire.@Answered Questionnaires&lt;/views&gt;&lt;filter entity="resco_questionnaire"&gt;&amp;lt;fetch&amp;gt;&amp;lt;entity name="resco_questionnaire"&amp;gt;	&amp;lt;filter type="and"&amp;gt;		&amp;lt;condition attribute='resco_istemplate' operator='eq' value='0' /&amp;gt;		&amp;lt;filter type="or"&amp;gt;			&amp;lt;condition attribute="resco_regardingid" operator="eq" value="{{activityid}}"/&amp;gt;			&amp;lt;condition attribute="resco_rawidvalue" entityname="QuestionLinkAlias" operator="eq" value="{{activityid}}"/&amp;gt;		&amp;lt;/filter&amp;gt;	&amp;lt;/filter&amp;gt;&amp;lt;link-entity name="resco_question" alias="QuestionLinkAlias" from="resco_questionnaireid" to="resco_questionnaireid" link-type="outer"/&amp;gt;&amp;lt;/entity&amp;gt;&amp;lt;/fetch&amp;gt;&lt;/filter&gt;&lt;/extra&gt;</Views>
      <LookupViews>&lt;extra&gt;&lt;views&gt;resco_questionnaire.Templates&lt;/views&gt;&lt;filter entity="resco_questionnaire"&gt;&amp;lt;fetch&amp;gt;&amp;lt;entity name='resco_questionnaire'&amp;gt;&amp;lt;filter&amp;gt;&amp;lt;condition attribute='resco_istemplate' operator='eq' value='1' /&amp;gt;&amp;lt;/filter&amp;gt;&amp;lt;/entity&amp;gt;&amp;lt;/fetch&amp;gt;&lt;/filter&gt;&lt;/extra&gt;</LookupViews>
    </FormTab>
    <FormTab xsi:type="AssociatedTab" flexiHeight="6" flexiHeader="2" NameModified="1" IconModified="0" EntityIconName="MobileCrm\Images.MonoTouch\Tabs\annotation@2x.png" IsIconNameReadOnly="0" DocCommands="0" FlipMode="224" ListCommands="0">
      <Name>INSPECTION REPORTS</Name>
      <CustomName>INSPECTION REPORTS</CustomName>
      <Binding SchemaName="annotation.@virtual"/>
      <Views>&lt;extra&gt;&lt;views&gt;annotation.@Reports&lt;/views&gt;&lt;filter entity="annotation"&gt;&amp;lt;fetch version="1.0"&amp;gt;&amp;lt;entity name="annotation"&amp;gt;&amp;lt;link-entity name="resco_questionnaire" from="resco_questionnaireid" to="objectid" link-type="inner" alias="L0"&amp;gt;&amp;lt;filter type="and"&amp;gt;&amp;lt;condition attribute="resco_regardingid" operator="eq" value="{{activityid}}" /&amp;gt;&amp;lt;/filter&amp;gt;&amp;lt;link-entity name="resco_question" from="resco_questionnaireid" to="resco_questionnaireid" link-type="outer" alias="L2"&amp;gt;&amp;lt;filter type="and"&amp;gt;&amp;lt;condition attribute="resco_rawidvalue" operator="eq" value="{{activityid}}" /&amp;gt;&amp;lt;/filter&amp;gt;&amp;lt;/link-entity&amp;gt;&amp;lt;/link-entity&amp;gt;&amp;lt;/entity&amp;gt;&amp;lt;/fetch&amp;gt;&lt;/filter&gt;&lt;/extra&gt;</Views>
    </FormTab>
    <FormTab xsi:type="AssociatedTab" flexi="0" flexiHeight="10" flexiHeader="2" NameModified="1" IconModified="0" EntityIconName="MobileCrm\Images.MonoTouch\Tabs\annotation@2x.png" IsIconNameReadOnly="0" FlipMode="224">
      <Name>NOTES</Name>
      <CustomName>NOTES</CustomName>
      <Binding SchemaName="annotation.objectid"/>
      <Views>annotation.@Default</Views>
    </FormTab>
  </SerializedChildrenV2>
